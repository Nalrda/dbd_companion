# --- TOKEN SAVERS (Pliki, które pożerają najwięcej tokenów) ---

# Wykluczamy ogromne pliki lock (Claude ich nie potrzebuje do pisania kodu)

pubspec.lock
ios/Podfile.lock
package-lock.json

# Wykluczamy wygenerowany kod (Claude zrozumie logikę z plików źródłowych)

_.g.dart
_.freezed.dart
\*.mocks.dart

